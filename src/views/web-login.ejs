<%- include('partials/head', { title: 'Login · IPstress', css: ['webtheme.css'] }) %>
<%- include('partials/web-header') %>

<div class="auth-wrapper d-flex no-block justify-content-center align-items-center position-relative">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="p-3">
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title text-center">IPstress</h2>
                        <h3 class="card-title text-center">Login</h3>
                        <form class="mt-4" method="post" action="/web/api/auth/login">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label class="text-white" for="username">Username</label>
                                        <input type="text" class="form-control" placeholder="enter your username"
                                               required name="username"/>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label class="text-white" for="password">Password</label>
                                        <input type="password" class="form-control" placeholder="enter your password"
                                               required name="password"/>
                                    </div>
                                </div>
                                <div class="col-lg-12 text-center">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-block btn-primary" name="doLogin"> Sign In </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-12 text-center mt-3">
                    Don&#39;t have an account? <a href="/web/register" class="text-primary">Sign Up</a>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>
