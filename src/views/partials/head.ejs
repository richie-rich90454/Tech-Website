<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <% if (locals.description) { %>
    <meta name="description" content="<%= description %>" />
    <% } %>
    <% if (!locals.noTheme) { %><script>try{var t=localStorage.getItem('theme');if(!t&&window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)t='dark';if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script><% } %>
    <link rel="icon" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <% (locals.css || ['globals.css']).forEach(function (file) { %>
    <link rel="stylesheet" href="/css/<%= file %>" />
    <% }) %>
    <% var allScripts = ['theme.js'].concat(locals.scripts || []); %>
    <% allScripts.forEach(function (file) { %>
    <script src="/js/<%= file %>" defer></script>
    <% }) %>
</head>
<body>
