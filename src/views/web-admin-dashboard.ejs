<%- include('partials/dash-head', { title: 'Admin Dashboard', crumb: 'Admin Dashboard' }) %>
<div class="container-fluid">
    <div class="card-group">
        <% [
            { value: s.totalUsers,     label: 'Total Users',      icon: 'users' },
            { value: s.activeUsers,    label: 'Active Users',     icon: 'users' },
            { value: s.totalAttacks,   label: 'Total Attacks',    icon: 'plus'  },
            { value: s.runningAttacks, label: 'Running Attacks',  icon: 'power' },
            { value: s.waitingTickets, label: 'Waiting Tickets',  icon: 'mail'  }
        ].forEach(function (card) { %>
            <div class="card border-right">
                <div class="card-body">
                    <div class="d-flex d-lg-flex d-md-block align-items-center">
                        <div>
                            <div class="d-inline-flex align-items-center">
                                <h2 class="text-white mb-1 font-weight-medium"><%= card.value %></h2>
                            </div>
                            <h6 class="text-muted font-weight-normal mb-0 w-100 text-truncate mb-2"><%= card.label %></h6>
                        </div>
                        <div class="ml-auto mt-md-3 mt-lg-0">
                            <span class="opacity-7 text-muted">
                                <%- include('partials/feather', { name: card.icon }) %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>
<%- include('partials/dash-foot') %>
