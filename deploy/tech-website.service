[Unit]
Description=Tech-Website (Next.js)
After=network.target

[Service]
Type=simple
# Run as a dedicated non-root user:
#   sudo useradd -r -s /usr/sbin/nologin techweb
#   sudo chown -R techweb:techweb /opt/tech-website
User=techweb
WorkingDirectory=/opt/tech-website
EnvironmentFile=/opt/tech-website/.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tech-website

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/tech-website/prisma

[Install]
WantedBy=multi-user.target
