{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true
    },
    "include": [
        "server.ts",
        "src/**/*.ts",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "drizzle.main.config.ts",
        "drizzle.web.config.ts"
    ],
    "exclude": ["src/app", "public/ts", "node_modules", ".next"]
}
