# Database (SQLite via Drizzle + better-sqlite3)
DATABASE_URL_MAIN="file:./prisma/main.db"
DATABASE_URL_WEB="file:./prisma/web.db"

# Session secrets — REQUIRED in production (app refuses to boot without them)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_SECRET_WEB=change-me-to-another-random-string-at-least-32-chars

# Admin bootstrap (npm run setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# reCAPTCHA — optional; app works without these
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Feature flags (true/false). Everything can be turned off here.
FEATURE_PAYMENTS=true
FEATURE_RECAPTCHA=false
FEATURE_WHEEL=true
FEATURE_AFFILIATE=true
FEATURE_GIFTCARDS=true
FEATURE_IPSTRESS=true

# Payments (Web subproject) — Stripe is live; PayPal/Bitcoin/CoinPayments use fetch integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
BITCOIN_ADDRESS=
COINPAYMENTS_PRIVATE_KEY=
COINPAYMENTS_PUBLIC_KEY=
